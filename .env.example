# HealthWise-AI Backend Environment Variables Template
# Copy this file to .env and adjust values for your local environment.

FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=healthwise_secret_key_change_in_production
PORT=5000

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=healthwise_ai

# Gemini API Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
